# ============ CloudBase Configuration ============
# 在腾讯云开发控制台获取：
#   1. 环境 ID：设置 > 环境设置
#   2. API Key：设置 > API 密钥管理
CLOUDBASE_ENV_ID=
CLOUDBASE_API_KEY=

# ============ Pusher Realtime Configuration ============
# 在 https://dashboard.pusher.com 创建免费应用后填入：
#   1. App ID / Secret：App Keys > App ID / Secret（仅服务端使用，切勿提交）
#   2. Key / Cluster：App Keys > key / cluster（公开，客户端使用，需 NEXT_PUBLIC_ 前缀）
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
